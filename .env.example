# Browser-exposed config — anything prefixed VITE_ ships to the client bundle.
# NEVER put the Supabase service-role key in any VITE_ var.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base URL of the KB search backend (POST endpoint). Leave unset to disable
# KB/Copilot search — there is no default knowledge base.
VITE_KB_SEARCH_URL=
